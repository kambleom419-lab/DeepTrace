# DeepTrace backend - copy to `.env` and adjust.
# Loaded by pydantic-settings from the working directory, so run uvicorn from backend/.

# ── database ─────────────────────────────────────────────────────────────────
# Local development: a single file. Azure: the managed PostgreSQL connection string.
DATABASE_URL=sqlite:///./deeptrace.db
# DATABASE_URL=postgresql+psycopg://deeptrace:PASSWORD@deeptrace-pg1234.postgres.database.azure.com:5432/deeptrace?sslmode=require

# ── file storage ─────────────────────────────────────────────────────────────
# local | azure   (the azure backend arrives in phase 3)
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT defaults to an absolute <repo>/backend/_storage, which is safer than
# a relative path (relative paths resolve against the working directory).
# LOCAL_STORAGE_ROOT=./_storage
# STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── queue ────────────────────────────────────────────────────────────────────
# inline  = run the job in-process via BackgroundTasks (phase 1)
# azure   = consume from Azure Storage Queue (phase 2+)
QUEUE_BACKEND=inline
QUEUE_NAME=jobs

# ── security ─────────────────────────────────────────────────────────────────
# CHANGE THIS. In Azure it comes from a Container Apps secret, never from this file.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=12

# ── behaviour ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
# real = run the trained PyTorch pipeline (~20 s per video)
# fake = return a canned result, for tests and fast UI iteration
ANALYSIS_MODE=real
# refuse to start if ml/weights/*.pt are missing (see app/mlbridge.py)
REQUIRE_WEIGHTS=true

# ── ML package ───────────────────────────────────────────────────────────────
# ML_PACKAGE_ROOT defaults to an absolute <repo>/ml - leave it unset unless the layout
# moves. It must be an ABSOLUTE path if you set it.
# ML_PACKAGE_ROOT=C:/Users/OM/desktop/DeepFake Detection/ml
# Only needed if ffmpeg is not on PATH.
FFMPEG_BIN=
