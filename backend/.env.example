# DeepTrace backend - copy to `.env` and adjust.
# Loaded by pydantic-settings from the working directory, so run uvicorn from backend/.

# ── database ─────────────────────────────────────────────────────────────────
# Local stack: `docker compose up -d` at the repo root. Postgres is published on host port
# 5433 because this machine already runs its own PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://deeptrace:deeptrace@127.0.0.1:5433/deeptrace
# No-Docker fallback: a single file, no server to start.
# DATABASE_URL=sqlite:///./deeptrace.db
# AWS: the managed PostgreSQL connection string (Phase 5). RDS requires TLS, hence sslmode.
# DATABASE_URL=postgresql+psycopg://deeptrace:PASSWORD@deeptrace.abc123.ap-south-1.rds.amazonaws.com:5432/deeptrace?sslmode=require

# ── file storage ─────────────────────────────────────────────────────────────
# s3    = an S3 bucket. AWS in the cloud, Moto locally from the same compose file.
# azure = Azure Blob. Locally that means Azurite, behind `--profile azure`.
# local = a plain directory on disk. The no-Docker fallback.
STORAGE_BACKEND=s3
S3_BUCKET=deeptrace
S3_REGION=ap-south-1
# Point at the emulator and give it dummy credentials. Leave BOTH of these unset in AWS: the
# ECS task role supplies the credentials, so there is no key in the image or the environment
# for anyone to leak.
S3_ENDPOINT_URL=http://127.0.0.1:5000
S3_ACCESS_KEY=testing
S3_SECRET_KEY=testing
# Azure instead of S3 - both are supported, and both pass the same test suite. Azurite's
# account name and key below are published in Microsoft's docs and are NOT secrets; they
# only ever work against the emulator.
# STORAGE_BACKEND=azure
# STORAGE_CONTAINER=deeptrace
# STORAGE_CONNECTION="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;"
# No-Docker fallback.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=./_storage

# ── queue ────────────────────────────────────────────────────────────────────
# database = the queued row IS the message. No extra infrastructure, and transactional with
#            the data it protects. The safe default.
# sqs      = an AWS SQS message (Moto locally). Same interface, and the row is still the
#            source of truth, so a lost message is recoverable.
# azure    = an Azure Storage Queue message (Azurite locally).
QUEUE_BACKEND=database
QUEUE_NAME=jobs
# Falls back to the S3 / storage-account settings, since one account holds blobs and queues.
# QUEUE_CONNECTION=
# SQS: leave blank to look the queue up by name (and create it if absent). In AWS the
# deployment creates it, so this is mainly a local convenience.
# SQS_QUEUE_URL=
# SQS_REGION, SQS_ENDPOINT_URL, SQS_ACCESS_KEY and SQS_SECRET_KEY all fall back to their S3
# equivalents, because Moto serves both services on one port.

# Whether THIS process also runs the worker loop.
#   true  = `uvicorn app.main:app` alone is a complete system (local development)
#   false = the API only queues; run `python -m app.worker` yourself (containers)
WORKER_IN_PROCESS=true

# Worker tuning (only used by whichever process runs the worker loop).
# WORKER_POLL_SECONDS=1.0
# WORKER_SWEEP_SECONDS=60.0
# STALE_CLAIM_MINUTES=30
# QUEUE_VISIBILITY_SECONDS=900
# QUEUE_RECONCILE_MINUTES=5
# SQS only: how long an empty receive blocks server-side. 20 keeps an idle worker at 3
# requests a minute; 0 turns long polling off. Must stay under the container stop timeout,
# because shutdown waits for the call to return.
# QUEUE_WAIT_SECONDS=20
# WORKER_ID=

# ── security ─────────────────────────────────────────────────────────────────
# CHANGE THIS. In AWS it comes from Secrets Manager, never from this file.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=12

# ── behaviour ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
# real = run the trained PyTorch pipeline (~20 s per video)
# fake = return a canned result, for tests and fast UI iteration
ANALYSIS_MODE=real
# refuse to start if ml/weights/*.pt are missing (see app/mlbridge.py)
REQUIRE_WEIGHTS=true

# ── ML package ───────────────────────────────────────────────────────────────
# ML_PACKAGE_ROOT defaults to an absolute <repo>/ml - leave it unset unless the layout
# moves. It must be an ABSOLUTE path if you set it.
# ML_PACKAGE_ROOT=C:/Users/OM/desktop/DeepFake Detection/ml
# Only needed if ffmpeg is not on PATH.
FFMPEG_BIN=
