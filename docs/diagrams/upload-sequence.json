      { "id": "worker", "label": "2 - A worker claims the job", "focus": ["wk", "q", "db", "s3"], "note": "The claim is a compare-and-swap, so a duplicate delivery finds the row taken and is discarded." },
      { "id": "render", "label": "3 - The browser polls and renders", "focus": ["spa", "api", "s3", "db"], "note": "The heatmap is fetched with the token and rendered from a blob URL - an img tag cannot send a header." }
