  "cards": [
    { "dot": "cyan", "title": "Why the API is fast", "items": ["It stores bytes and a row, then enqueues - no inference in the request path", "The row with status=queued IS the job record, committed before the message is sent", "A failed enqueue is logged and recovered by the worker's reconcile sweep"] },
    { "dot": "emerald", "title": "Why duplicates are safe", "items": ["SQS standard queues are at-least-once, so redelivery is expected", "The claim is a compare-and-swap, so the second delivery finds the row taken", "Analysis is idempotent - a re-run replaces the previous result"] },
    { "dot": "amber", "title": "Why the heatmap needs a fetch", "items": ["The evidence route is authenticated and an img tag cannot send a header", "The SPA fetches it with the token and renders a blob URL", "The same trick serves the source video, which also needs byte ranges"] }
